{
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Bash(pip install:*)",
      "Bash(pip uninstall:*)",
      "Read(./.env)",
      "Read(./**/*.env)",
      "Read(./**/*cookie*)"
    ],
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff check:*)",
      "Bash(python -m compileall:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_check.py\"" }
        ]
      }
    ]
  }
}
